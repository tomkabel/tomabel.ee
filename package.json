{
  "name": "tomabel.ee",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@11.5.3",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "canonical": "node scripts/canonical-text.mjs",
    "postbuild": "node scripts/spa-routes.mjs",
    "sbom:gen": "pnpm sbom --sbom-format cyclonedx --lockfile-only > pub/sbom.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "lucide-react": "1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fontaine": "^1.0.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
